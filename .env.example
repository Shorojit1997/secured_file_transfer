# Copy to .env and adjust. Never commit .env.
# Every value has a working local default, so an empty .env still runs `yarn dev`.

# ============================================================
# Backend  —  schema: server/src/config/env.ts
# ============================================================

NODE_ENV=development
PORT=3000
TRUSTED_PROXY_HOPS=0

# The single origin the browser uses to reach the app. It drives CORS, the CSRF
# Origin check, and the links in verification and password-reset mail.
# Leave it unset and each stack uses its own default: http://localhost:5100 for
# `yarn dev`, http://localhost:8080 for `docker compose up`. Set it for a real
# domain, or whenever you change CLIENT_PORT or APP_PORT below.
# APP_ORIGIN=https://files.example.com

DATABASE_URL=postgres://app:app@localhost:5433/app

# Redis backs the BullMQ queues that send mail and run the janitor. The default
# points at the Redis published by docker-compose.yml, so `yarn dev` needs
# `docker compose up -d postgres redis` and nothing else.
REDIS_URL=redis://localhost:6380
BLOB_ROOT=var/blobs

# Required in production (openssl rand -base64 32). Dev has an insecure built-in default.
# The Docker stack runs NODE_ENV=production, so `docker compose up` needs both set.
FIELD_ENCRYPTION_KEY=
EMAIL_LOOKUP_PEPPER=

# Mail delivery. Production needs exactly one of RESEND_API_KEY or SMTP_URL.
# RESEND_API_KEY wins when both are set: it delivers over HTTPS, which is the
# only option on hosts that block outbound SMTP ports (Render, Fly, Heroku).
# Unset (or blank) locally writes emails to var/mail/*.eml instead; blank in the
# Docker stack routes mail to the bundled Mailpit instead.
# MAIL_FROM must be an address on a domain verified in the Resend dashboard.
RESEND_API_KEY=
SMTP_URL=
MAIL_FROM=no-reply@example.com

MAX_UPLOAD_BYTES=2147483648
MAX_CHUNK_BYTES=4194320
ACCOUNT_QUOTA_BYTES=10737418240
TRANSFER_DEFAULT_TTL_HOURS=168
TRANSFER_MAX_TTL_HOURS=720
DOWNLOAD_GRANT_TTL_MINUTES=15
SESSION_IDLE_HOURS=24
SESSION_ABSOLUTE_DAYS=14

# ============================================================
# Frontend
# ============================================================
# Nothing here reaches the browser bundle: the app calls /api on its own origin,
# so there are no VITE_ variables. Changing CLIENT_PORT means setting APP_ORIGIN
# to match.
#
# CLIENT_PORT is read by client/vite.config.ts, dev server only.
#
# API_PROXY_TARGET is where /api is forwarded, and both proxies read it: the
# Vite dev server (client/vite.config.ts) and the production nginx image
# (client/nginx.conf.template). It defaults to http://localhost:3000 for
# `yarn dev` and http://server:3000 inside the container. Set it to the
# server's own URL whenever the two are deployed as separate services.

CLIENT_PORT=5100
API_PROXY_TARGET=http://localhost:3000

# ============================================================
# Docker Compose only
# ============================================================
# APP_PORT publishes nginx to the host; changing it means setting APP_ORIGIN to
# match. The dev overlay serves Vite on CLIENT_PORT instead.

APP_PORT=8080
MAILPIT_UI_PORT=8025
REDIS_PORT=6380
